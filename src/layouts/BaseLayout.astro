---
// BaseLayout — site-wide shell. All pages compose this.
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WipBanner from '@/components/WipBanner.astro';

interface Props {
  title?: string;
  description?: string;
  /** Show site-picker / breadcrumb in header */
  currentSite?: { slug: string; name: string } | null;
  /** When true, header is rendered transparent over the hero section */
  transparentHeader?: boolean;
  /** When true, removes the default page padding so children can go full-bleed */
  bleed?: boolean;
}

const {
  title = 'Lichen Atlas',
  description = 'A field-research atlas of lichens colonizing historical cemeteries — Maayan Magenheim, Bezalel Bio-Design.',
  currentSite = null,
  transparentHeader = false,
  bleed = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F1115" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />

    <!-- Web fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Frank+Ruhl+Libre:wght@400;500;700&family=UnifrakturMaguntia&display=swap"
    />

    <title>{title === 'Lichen Atlas' ? title : `${title} — Lichen Atlas`}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <slot name="head" />
  </head>

  <body class="min-h-screen flex flex-col bg-slate-850 text-bone-100">
    <WipBanner />
    <Header currentSite={currentSite} transparent={transparentHeader} />

    <main class={`flex-1 ${bleed ? '' : 'px-4 md:px-8 py-8'}`}>
      <slot />
    </main>

    <Footer />
  </body>
</html>
