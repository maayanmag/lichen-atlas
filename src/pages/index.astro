---
// Home / site picker — currently 1 site, future-ready
import BaseLayout from '@/layouts/BaseLayout.astro';

// Statically import the site index. As more sites land in public/sites/<slug>/site.json
// they get listed here. For now we hard-code the templer site presence and let the
// build fail loudly if it's missing.
let sites: Array<any> = [];
try {
  // dynamic require via Astro's import.meta.glob — picks up any site.json in public/
  // (Astro doesn't expose public/ at build time, so we read from the project at build)
  const fs = await import('node:fs');
  const path = await import('node:path');
  const url = await import('node:url');
  const here = path.dirname(url.fileURLToPath(import.meta.url));
  const sitesDir = path.resolve(here, '../../public/sites');
  if (fs.existsSync(sitesDir)) {
    for (const slug of fs.readdirSync(sitesDir).sort()) {
      const p = path.join(sitesDir, slug, 'site.json');
      if (fs.existsSync(p)) {
        const data = JSON.parse(fs.readFileSync(p, 'utf-8'));
        sites.push({ slug, ...data });
      }
    }
  }
} catch (e) {
  console.warn('No sites discovered yet:', e);
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Lichen Atlas" transparentHeader bleed>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-slate-850/0 to-slate-850"></div>
      <div class="absolute inset-0 opacity-40 mix-blend-screen"
           style="background: radial-gradient(circle at 20% 0%, rgba(224,122,46,0.18), transparent 55%), radial-gradient(circle at 80% 30%, rgba(157,166,126,0.10), transparent 50%);"></div>
    </div>

    <div class="max-w-page mx-auto px-4 md:px-8 pt-32 pb-24 md:pt-44 md:pb-36">
      <p class="text-[11px] uppercase tracking-[0.24em] text-slate-600 mb-6">Field documentation · Bio-Design</p>
      <h1 class="font-serif text-bone-50 max-w-4xl">
        Lichen Atlas <span class="text-ember">—</span> life within the memory stone.
      </h1>
      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-bone-200">
        A growing record of lichen colonies on historical cemetery stones across Jerusalem.
        Each stone is a known-age <em>test block</em>; each colony, a slow re-writer of the inscription beneath it.
      </p>
      <p class="mt-3 max-w-2xl text-sm text-slate-600">
        Part of <a href="https://bezalel.ac.il" class="underline-offset-2 underline decoration-dotted hover:text-ember">Bezalel Academy</a>'s M.Des Bio-Design course
      </p>
    </div>
  </section>

  <!-- Sites grid -->
  <section class="max-w-page mx-auto px-4 md:px-8 pb-24">
    <div class="flex items-end justify-between mb-8">
      <h2>Field sites</h2>
      <span class="text-xs text-slate-600 uppercase tracking-wider">{sites.length} site{sites.length === 1 ? '' : 's'} · more planned</span>
    </div>

    {sites.length === 0 && (
      <div class="panel p-8 text-bone-200">
        <p>No sites ingested yet. Run <code class="text-ember">npm run ingest:templer</code> from this project's root to populate the first site.</p>
      </div>
    )}

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sites.map((s: any) => (
        <a href={`${base}/sites/${s.slug}/`} class="group panel p-6 hover:border-ember/40 transition-colors">
          <div class="flex items-baseline justify-between mb-3">
            <h3 class="group-hover:text-ember transition-colors">{s.name}</h3>
            <span class="text-xs text-slate-600">{s.location ?? '—'}</span>
          </div>
          <p class="text-sm text-bone-200 mb-4">{s.tagline ?? s.description ?? ''}</p>
          <div class="flex items-center gap-4 text-xs text-slate-600">
            <span><span class="text-bone-200">{s.stone_count ?? '?'}</span> stones</span>
            <span><span class="text-bone-200">{s.photo_count ?? '?'}</span> photos</span>
            {s.date_range && <span>{s.date_range}</span>}
          </div>
        </a>
      ))}

      <!-- Placeholder card hinting at future growth -->
      <div class="panel p-6 border-dashed opacity-60">
        <h3 class="text-bone-300">Future site</h3>
        <p class="text-sm text-slate-600 mt-2">Har ha-Menukhot, Har ha-Zeitim, Wilhelma, Sarona — more cemeteries are planned. The atlas grows with each visit.</p>
      </div>
    </div>
  </section>
</BaseLayout>
