---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { listAllSites, loadStones } from '@/lib/data';
import { genusInfo } from '@/lib/lichens';
import { t } from '@/lib/strings';

const locale = 'he' as const;
const sites = listAllSites(locale);

interface GenusAgg {
  genus: string;
  totalStones: number;
  bySite: Record<string, number>;
  speciesGuesses: Set<string>;
}
const agg: Record<string, GenusAgg> = {};

for (const site of sites) {
  const stones = loadStones(site.slug, locale);
  for (const s of stones) {
    for (const g of s.lichen_genera) {
      if (!agg[g]) agg[g] = { genus: g, totalStones: 0, bySite: {}, speciesGuesses: new Set() };
      agg[g].totalStones++;
      agg[g].bySite[site.slug] = (agg[g].bySite[site.slug] ?? 0) + 1;
      for (const sp of s.lichen_species) {
        if (sp.startsWith(g)) agg[g].speciesGuesses.add(sp);
      }
    }
  }
}

const genera = Object.values(agg).sort((a, b) => b.totalStones - a.totalStones);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={t('lichens.title', locale)} description={t('lichens.lede', locale)} locale={locale}>
  <article class="max-w-page mx-auto py-12">
    <p class="text-[11px] uppercase tracking-[0.24em] text-slate-600 mb-4">{t('lichens.eyebrow', locale)}</p>
    <h1>{t('lichens.title', locale)}</h1>
    <p class="mt-4 max-w-2xl text-bone-200 text-lg leading-relaxed">{t('lichens.lede', locale)}</p>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6">
      {genera.map(g => {
        const info = genusInfo(g.genus, locale);
        return (
          <section class="panel p-6">
            <header class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-3">
                <span class="w-4 h-4 rounded-full ring-1 ring-white/10" style={`background: ${info.color}`} />
                <h3 class="italic" dir="ltr">{g.genus}</h3>
              </div>
              <span class="text-xs text-slate-600 tabular-nums">{g.totalStones} {t('lichens.stones.suffix', locale)}</span>
            </header>
            <p class="text-sm text-bone-200 leading-relaxed">{info.description}</p>
            {g.speciesGuesses.size > 0 && (
              <>
                <hr class="hr-soft" />
                <p class="text-[11px] uppercase tracking-wider text-slate-600 mb-2">{t('lichens.species.heading', locale)}</p>
                <ul class="text-sm text-bone-200 space-y-1">
                  {Array.from(g.speciesGuesses).sort().map(sp => <li class="italic" dir="ltr">{sp}</li>)}
                </ul>
              </>
            )}
            <div class="mt-4 pt-3 border-t border-slate-700/40 text-xs text-slate-600 flex items-center gap-3 flex-wrap">
              <span class="uppercase tracking-wider">{t('lichens.bysite.label', locale)}</span>
              {Object.entries(g.bySite).map(([slug, n]) => (
                <a class="text-bone-200 hover:text-ember" href={`${base}/he/sites/${slug}/`}>{slug} <span class="text-slate-600 tabular-nums">{n}</span></a>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    <hr class="hr-soft mt-12" />

    <div class="mt-8 text-sm text-slate-600 max-w-3xl">
      <p>{t('lichens.outro', locale)}</p>
    </div>
  </article>
</BaseLayout>
