---
import { type Locale } from '@/lib/i18n';
import { t } from '@/lib/strings';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-700/40 mt-12">
  <div class="max-w-page mx-auto px-4 md:px-8 py-10 grid md:grid-cols-3 gap-8 text-sm text-slate-600">
    <div>
      <h4 class="font-serif text-bone-100 mb-2">{t('footer.col1.title', locale)}</h4>
      <p class="text-slate-600 text-xs leading-relaxed">{t('footer.col1.body', locale)}</p>
    </div>
    <div>
      <h4 class="font-serif text-bone-100 mb-2">{t('footer.col2.title', locale)}</h4>
      <ul class="space-y-1.5 text-xs">
        <li>{t('footer.col2.line1', locale)}</li>
        <li>{t('footer.col2.line2', locale)} · {year}</li>
      </ul>
    </div>
    <div>
      <h4 class="font-serif text-bone-100 mb-2">{t('footer.col3.title', locale)}</h4>
      <ul class="space-y-1.5 text-xs">
        <li>{t('footer.col3.line1', locale)}</li>
        <li>{t('footer.col3.line2', locale)}</li>
      </ul>
    </div>
  </div>
</footer>

