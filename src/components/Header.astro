---
// Header — quiet top bar with brand + site context + EN | עברית switcher.
import { pathInOtherLocale, type Locale } from '@/lib/i18n';
import { t } from '@/lib/strings';

interface Props {
  currentSite?: { slug: string; name: string } | null;
  transparent?: boolean;
  locale?: Locale;
}
const { currentSite = null, transparent = false, locale = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = locale === 'he' ? `${base}/he/` : `${base}/`;
const lichensHref = locale === 'he' ? `${base}/he/lichens` : `${base}/lichens`;
const aboutHref = locale === 'he' ? `${base}/he/about` : `${base}/about`;
const otherPath = pathInOtherLocale(Astro.url, base);
const siteHref = currentSite
  ? (locale === 'he' ? `${base}/he/sites/${currentSite.slug}/` : `${base}/sites/${currentSite.slug}/`)
  : null;
---

<header
  class:list={[
    'sticky top-0 z-40 w-full backdrop-blur-md transition-colors',
    transparent ? 'bg-slate-850/30 border-b border-transparent' : 'bg-slate-850/80 border-b border-slate-700/40',
  ]}
>
  <div class="max-w-page mx-auto flex items-center justify-between px-4 md:px-8 h-16">
    <!-- Brand -->
    <a href={home} class="group flex items-center gap-3">
      <!-- Tiny mark: a fragment of placodioid rosette -->
      <svg width="28" height="28" viewBox="0 0 28 28" class="text-ember" aria-hidden="true">
        <circle cx="14" cy="14" r="11" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.4"/>
        <circle cx="14" cy="14" r="6.5" fill="none" stroke="currentColor" stroke-width="1.2"/>
        <circle cx="14" cy="14" r="2.4" fill="currentColor" opacity="0.85"/>
        <g stroke="currentColor" stroke-width="0.7" opacity="0.55">
          <line x1="14" y1="3" x2="14" y2="6.5"/>
          <line x1="14" y1="21.5" x2="14" y2="25"/>
          <line x1="3" y1="14" x2="6.5" y2="14"/>
          <line x1="21.5" y1="14" x2="25" y2="14"/>
          <line x1="6.2" y1="6.2" x2="8.6" y2="8.6"/>
          <line x1="19.4" y1="19.4" x2="21.8" y2="21.8"/>
          <line x1="6.2" y1="21.8" x2="8.6" y2="19.4"/>
          <line x1="19.4" y1="8.6" x2="21.8" y2="6.2"/>
        </g>
      </svg>
      <div class="flex flex-col leading-none">
        <span class="font-serif text-lg tracking-tight text-bone-50 group-hover:text-ember transition-colors">{t('brand.title', locale)}</span>
        <span class="text-[10px] uppercase tracking-[0.18em] text-slate-600">{t('brand.subtitle', locale)}</span>
      </div>
    </a>

    <!-- Right: site context + nav + lang switcher -->
    <nav class="flex items-center gap-2 md:gap-4 text-sm text-bone-200">
      {currentSite && siteHref && (
        <span class="hidden md:inline text-slate-600">·</span>
        <a href={siteHref} class="hidden md:inline text-bone-200 hover:text-ember">
          {currentSite.name}
        </a>
      )}
      <a href={lichensHref} class="hidden sm:inline px-2 py-1 rounded hover:text-ember">{t('nav.lichens', locale)}</a>
      <a href={aboutHref}    class="hidden sm:inline px-2 py-1 rounded hover:text-ember">{t('nav.about', locale)}</a>

      <!-- Language switcher: EN | עברית -->
      <div class="flex items-center gap-1 ms-1 ps-2 border-s border-slate-700/40 text-xs" role="group" aria-label={t('switcher.aria', locale)}>
        <a
          href={locale === 'en' ? '#' : otherPath}
          aria-current={locale === 'en' ? 'page' : undefined}
          class:list={[
            'px-1.5 py-0.5 rounded uppercase tracking-wider',
            locale === 'en' ? 'text-ember' : 'text-bone-300 hover:text-ember',
          ]}
        >EN</a>
        <span class="text-slate-700" aria-hidden="true">|</span>
        <a
          href={locale === 'he' ? '#' : otherPath}
          aria-current={locale === 'he' ? 'page' : undefined}
          class:list={[
            'px-1.5 py-0.5 rounded font-hebrew text-sm',
            locale === 'he' ? 'text-ember' : 'text-bone-300 hover:text-ember',
          ]}
        >עברית</a>
      </div>
    </nav>
  </div>
</header>

