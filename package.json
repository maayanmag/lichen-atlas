{
  "name": "lichen-atlas",
  "type": "module",
  "version": "0.1.0",
  "description": "A multi-site web atlas of lichens colonizing historical cemeteries — Bezalel Bio-Design / Maayan Magenheim",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "ingest": "python3 scripts/ingest_site.py",
    "ingest:templer": "python3 scripts/ingest_site.py --site templer-cemetery",
    "ingest:pardes-hahaim": "python3 scripts/ingest_site.py --site pardes-hahaim"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.0",
    "@astrojs/tailwind": "^6.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "astro": "^5.16.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^3.4.18"
  },
  "engines": {
    "node": ">=18.20.0"
  }
}
